---
import Base from "../layouts/Base.astro";
import {
  bookingsOf,
  isDevice,
  listResources,
  MAX_PARTNERS,
  slotKey,
  takenOn,
} from "../lib/bookings";
import type { Resource } from "../lib/schema";
import {
  bookableDays,
  canberraNow,
  dayLabel,
  holidayName,
  hourLabel,
  hoursOf,
  isBookable,
  slotLabel,
} from "../lib/time";

const now = canberraNow();
const days = bookableDays(now);
const requested = Astro.url.searchParams.get("day");
const day = days.find((d) => d === requested) ?? days[0];
const hours = hoursOf(day);
const taken = takenOn(day);
const holiday = holidayName(day);

const device = Astro.cookies.get("device")?.value;
const mine = isDevice(device) ? bookingsOf(device, now) : [];

const venues: [string, Resource[]][] = [];
for (const resource of listResources()) {
  const group = venues.find(([venue]) => venue === resource.venue);
  if (group) group[1].push(resource);
  else venues.push([resource.venue, [resource]]);
}

const MESSAGES: Record<string, string> = {
  booked: "Booked — it's yours. It's listed under “Your booking”.",
  cancelled: "Cancelled. The slot is free again, and so is every player's hour.",
  "slot-taken": "Someone booked that slot just before you. Pick another one.",
  "week-used": "One of the players has already used their free hour that week.",
  invalid:
    "Check the uni IDs: each is a u and 7 digits, and each player can be listed only once.",
  closed: "That slot can't be booked any more: it has started, or it's outside the free hour.",
  "not-cancelled":
    "That booking couldn't be cancelled: it has started, or it was made on another device.",
  forgotten: "This device has been forgotten. Your booking still stands.",
};
const status = Astro.url.searchParams.get("status");
const error = Astro.url.searchParams.get("error");
const message = (error && MESSAGES[error]) || (status && MESSAGES[status]);
---

<Base title="Free Hour — book your free student court hour" current="book">
  <main>
    <section class="hero">
      <div class="wrap hero__inner">
        <h1>Book your free student hour</h1>
        <p class="hero__lede">
          Every ANU student gets one free court hour a week, weekdays before 2pm. Book it here in
          seconds: no front desk, no 15-minute wait.
        </p>
        <a class="pill pill--yellow" href="#book">Book a court now</a>
      </div>
    </section>

    <div class="wrap">
      {
        message && (
          <p class:list={["notice", { error: Boolean(error) }]} role="status">
            {message}
          </p>
        )
      }

      {
        mine.length > 0 && (
          <section id="my-booking" aria-labelledby="my-booking-title">
            <h2 id="my-booking-title">Your booking</h2>
            <ul>
              {mine.map((booking) => {
                const where = `${booking.venue} ${booking.name}`;
                const when = `${dayLabel(booking.slot.date)}, ${slotLabel(booking.slot.hour)}`;
                return (
                  <li data-slot={slotKey(booking.slot)}>
                    <span>
                      <strong>{where}</strong>
                      <span class="when">{when}</span>
                      <span class="players">
                        {booking.players} {booking.players === 1 ? "player" : "players"}
                      </span>
                    </span>
                    {booking.started ? (
                      <span class="underway">Under way</span>
                    ) : (
                      <form method="post" action="/api/bookings/cancel">
                        <input type="hidden" name="id" value={booking.id} />
                        <button class="pill pill--grey">
                          Cancel<span class="visually-hidden">{` ${where}, ${when}`}</span>
                        </button>
                      </form>
                    )}
                  </li>
                );
              })}
            </ul>
            <form method="post" action="/api/forget" class="forget">
              <button class="pill pill--grey">Forget this device</button>
              <span class="hint">
                On a shared computer? Then the next person can't see or cancel your booking.
              </span>
            </form>
          </section>
        )
      }

      <section id="book" class="book" aria-labelledby="book-title">
        <h2 id="book-title">Book a court</h2>

        <h3 class="step"><span class="step__num" aria-hidden="true">1</span>Pick a day</h3>
        <nav aria-label="Days" class="days">
          <ul>
            {
              days.map((d) => (
                <li>
                  <a href={`/?day=${d}#book`} aria-current={d === day ? "date" : undefined}>
                    {dayLabel(d)}
                    {holidayName(d) && <span class="holiday">{holidayName(d)}</span>}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <form method="post" action="/api/bookings" class="booking">
          <fieldset class="who">
            <legend class="step">
              <span class="step__num" aria-hidden="true">2</span>Who's playing
            </legend>
            <div class="fields">
              <div class="field">
                <label for="uid">Your uni ID</label>
                <input
                  id="uid"
                  name="uid"
                  required
                  pattern="[uU][0-9]{7}"
                  autocomplete="off"
                  spellcheck="false"
                  aria-describedby="uid-hint"
                />
              </div>
              {
                Array.from({ length: MAX_PARTNERS }, (_, i) => (
                  <div class="field">
                    <label for={`partner-${i + 1}`}>
                      Partner {i + 1} <span class="optional">(optional)</span>
                    </label>
                    <input
                      id={`partner-${i + 1}`}
                      name="partner"
                      pattern="[uU][0-9]{7}"
                      autocomplete="off"
                      spellcheck="false"
                      aria-describedby="uid-hint"
                    />
                  </div>
                ))
              }
            </div>
            <p id="uid-hint" class="hint">
              A u and 7 digits. Uni IDs are only used to count free hours and are never shown to
              anyone.
            </p>
          </fieldset>

          <h3 class="step"><span class="step__num" aria-hidden="true">3</span>Tap a free slot</h3>
          <div class="grid" role="region" aria-labelledby="slots-caption" tabindex="0">
            <table>
              <caption id="slots-caption">
                {dayLabel(day)}
                {holiday && ` · ${holiday}, opens 9am`} · Canberra time
              </caption>
              <thead>
                <tr>
                  <th scope="col">Court</th>
                  {hours.map((hour) => <th scope="col">{hourLabel(hour)}</th>)}
                </tr>
              </thead>
              {
                venues.map(([venue, courts]) => (
                  <tbody>
                    <tr class="venue">
                      <th scope="rowgroup" colspan={hours.length + 1}>
                        {venue}
                      </th>
                    </tr>
                    {courts.map((court) => (
                      <tr>
                        <th scope="row">
                          {court.name}
                          <span class="sports">{court.sports}</span>
                        </th>
                        {hours.map((hour) => {
                          const key = slotKey({ resourceId: court.id, date: day, hour });
                          const state = taken.has(key)
                            ? "taken"
                            : isBookable(day, hour, now)
                              ? "free"
                              : "past";
                          return (
                            <td>
                              <button
                                name="slot"
                                value={key}
                                class={`slot ${state}`}
                                disabled={state !== "free"}
                              >
                                <span class="label">
                                  {state === "free" ? "Book" : state === "taken" ? "Booked" : "Past"}
                                </span>
                                <span class="visually-hidden">
                                  {` ${venue} ${court.name}, ${slotLabel(hour)}`}
                                </span>
                              </button>
                            </td>
                          );
                        })}
                      </tr>
                    ))}
                  </tbody>
                ))
              }
            </table>
          </div>
        </form>
      </section>

      <section id="how" class="how" aria-labelledby="how-title">
        <h2 id="how-title">How the free hour works</h2>
        <ul class="rules">
          <li>
            <strong>One free hour a week</strong>
            Every ANU student, Monday to Sunday.
          </li>
          <li>
            <strong>Weekdays, 6am–2pm</strong>
            From 9am on public holidays. Book up to 7 days ahead.
          </li>
          <li>
            <strong>List everyone playing</strong>
            Each listed player uses their free hour for that week, so a group can't chain hours.
          </li>
        </ul>
      </section>
    </div>
  </main>

  <script>
    // When anyone books or cancels, the matching cell changes in every open
    // page, so nobody picks a slot that has just gone. The form works
    // without this.
    const source = new EventSource("/api/events");
    source.addEventListener("message", (event) => {
      const { slot, taken } = JSON.parse(event.data) as { slot: string; taken: boolean };
      const button = document.querySelector<HTMLButtonElement>(
        `button[name="slot"][value="${CSS.escape(slot)}"]`,
      );
      const label = button?.querySelector(".label");
      if (!button || !label) return;
      button.disabled = taken;
      button.classList.toggle("free", !taken);
      button.classList.toggle("taken", taken);
      label.textContent = taken ? "Booked" : "Book";
    });
  </script>
</Base>
